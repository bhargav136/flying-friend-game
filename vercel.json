{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "autoplay=*"
        },
        {
          "key": "Feature-Policy",
          "value": "autoplay *"
        }
      ]
    }
  ]
}
